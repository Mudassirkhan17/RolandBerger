# Optional. Helios works in local grounded mode without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required for auth (JWT signing). Set any random string locally.
JWT_SECRET=dev-secret-change-me

# Runtime
HELIOS_HOST=127.0.0.1
HELIOS_PORT=8000
HELIOS_CORPUS_PATH=../helios_rag_corpus
HELIOS_DATABASE_PATH=./data/helios.db
